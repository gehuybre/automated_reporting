{
    "themes": {
        "default": {
            "layout": {
                "font": {
                    "family": "Arial, sans-serif",
                    "size": 12,
                    "color": "#444444"
                },
                "title": {
                    "font": {
                        "family": "Arial, sans-serif",
                        "size": 18,
                        "color": "#222222"
                    },
                    "x": 0.5,
                    "xanchor": "center"
                },
                "legend": {
                    "font": {
                        "family": "Arial, sans-serif",
                        "size": 10,
                        "color": "#444444"
                    },
                    "bgcolor": "rgba(255, 255, 255, 0.5)",
                    "bordercolor": "#DDDDDD",
                    "borderwidth": 1,
                    "orientation": "v",
                    "xanchor": "right",
                    "x": 0.99,
                    "yanchor": "top",
                    "y": 0.99
                },
                "colorway": [
                    "#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", 
                    "#9467bd", "#8c564b", "#e377c2", "#7f7f7f", 
                    "#bcbd22", "#17becf"
                ],
                "plot_bgcolor": "#FFFFFF",
                "paper_bgcolor": "#FFFFFF",
                "margin": {
                    "l": 80,
                    "r": 80,
                    "t": 100,
                    "b": 80,
                    "pad": 10
                },
                "hovermode": "closest",
                "hoverlabel": {
                    "bgcolor": "#FFFFFF",
                    "font": {
                        "family": "Arial, sans-serif",
                        "size": 12,
                        "color": "#444444"
                    },
                    "bordercolor": "#DDDDDD"
                },
                "xaxis": {
                    "title": {
                        "font": {
                            "family": "Arial, sans-serif",
                            "size": 14,
                            "color": "#444444"
                        },
                        "standoff": 15
                    },
                    "showgrid": true,
                    "gridcolor": "#EEEEEE",
                    "gridwidth": 1,
                    "zeroline": true,
                    "zerolinecolor": "#CCCCCC",
                    "zerolinewidth": 1,
                    "showline": true,
                    "linecolor": "#CCCCCC",
                    "linewidth": 1,
                    "ticks": "outside",
                    "tickfont": {
                        "family": "Arial, sans-serif",
                        "size": 10,
                        "color": "#444444"
                    },
                    "ticklen": 5,
                    "tickwidth": 1,
                    "tickcolor": "#CCCCCC",
                    "automargin": true
                },
                "yaxis": {
                    "title": {
                        "font": {
                            "family": "Arial, sans-serif",
                            "size": 14,
                            "color": "#444444"
                        },
                        "standoff": 15
                    },
                    "showgrid": true,
                    "gridcolor": "#EEEEEE",
                    "gridwidth": 1,
                    "zeroline": true,
                    "zerolinecolor": "#CCCCCC",
                    "zerolinewidth": 1,
                    "showline": true,
                    "linecolor": "#CCCCCC",
                    "linewidth": 1,
                    "ticks": "outside",
                    "tickfont": {
                        "family": "Arial, sans-serif",
                        "size": 10,
                        "color": "#444444"
                    },
                    "ticklen": 5,
                    "tickwidth": 1,
                    "tickcolor": "#CCCCCC",
                    "automargin": true
                }
            },
            "traces": {
                "line": {
                    "line": {
                        "width": 2.5,
                        "shape": "linear"
                    },
                    "marker": {
                        "size": 6,
                        "opacity": 0.8
                    },
                    "mode": "lines+markers",
                    "hovertemplate": "%{y:,.1f}<extra>%{x}</extra>"
                },
                "bar": {
                    "marker": {
                        "line": {
                            "width": 0.5,
                            "color": "#FFFFFF"
                        },
                        "opacity": 0.85
                    },
                    "hovertemplate": "%{y:,.1f}<extra>%{x}</extra>"
                },
                "scatter": {
                    "marker": {
                        "size": 8,
                        "opacity": 0.9,
                        "line": {
                            "width": 1,
                            "color": "#FFFFFF"
                        }
                    },
                    "mode": "markers",
                    "hovertemplate": "%{y:,.1f}<extra>%{x}</extra>"
                },
                "area": {
                    "line": {
                        "width": 1.5,
                        "shape": "linear"
                    },
                    "fill": "tozeroy",
                    "fillcolor": "rgba(26, 150, 65, 0.1)",
                    "marker": {
                        "size": 5,
                        "opacity": 0.7
                    },
                    "mode": "lines",
                    "hovertemplate": "%{y:,.1f}<extra>%{x}</extra>"
                },
                "pie": {
                    "marker": {
                        "line": {
                            "width": 1,
                            "color": "#FFFFFF"
                        }
                    },
                    "textinfo": "percent+label",
                    "hoverinfo": "label+percent+value",
                    "hovertemplate": "%{label}: %{value:,.1f} (%{percent})<extra></extra>"
                },
                "heatmap": {
                    "colorscale": "Viridis",
                    "showscale": true,
                    "hovertemplate": "X: %{x}<br>Y: %{y}<br>Value: %{z}<extra></extra>"
                }
            }
        },
