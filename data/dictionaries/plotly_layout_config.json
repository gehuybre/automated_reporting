    "customizations": {
        "annotations": {
            "default": {
                "font": {
                    "family": "Arial, sans-serif",
                    "size": 12,
                    "color": "#444444"
                },
                "align": "center",
                "showarrow": true,
                "arrowcolor": "#444444",
                "arrowhead": 2,
                "arrowsize": 1,
                "arrowwidth": 1,
                "ax": -30,
                "ay": -40,
                "bgcolor": "rgba(255, 255, 255, 0.8)",
                "bordercolor": "#DDDDDD",
                "borderpad": 4,
                "borderwidth": 1
            }
        },
        "watermark": {
            "enabled": false,
            "text": "Your Organization",
            "font": {
                "family": "Arial, sans-serif",
                "size": 20,
                "color": "rgba(200, 200, 200, 0.3)"
            },
            "x": 0.5,
            "y": 0.5,
            "xanchor": "center",
            "yanchor": "middle",
            "angle": -30
        },
        "responsive": {
            "autosize": true,
            "minWidth": 400,
            "maxWidth": 1200,
            "initialWidth": 800,
            "initialHeight": 500
        },
        "download": {
            "filename": "plot",
            "scale": 2,
            "format": "png",
            "height": 800,
            "width": 1200
        }
    },
    "graph_types": {
        "financial": {
            "layout": {
                "xaxis": {
                    "rangebreaks": [
                        {"pattern": "day of week", "bounds": ["sat", "mon"]}
                    ]
                }
            },
            "traces": {
                "candlestick": {
                    "increasing": {"line": {"color": "#26A69A"}},
                    "decreasing": {"line": {"color": "#EF5350"}},
                    "line": {"width": 1},
                    "whiskerwidth": 0.5
                },
                "ohlc": {
                    "increasing": {"line": {"color": "#26A69A"}},
                    "decreasing": {"line": {"color": "#EF5350"}},
                    "line": {"width": 1}
                }
            }
        },
        "statistic": {
            "traces": {
                "box": {
                    "boxmean": true,
                    "jitter": 0.3,
                    "pointpos": -1.8,
                    "boxpoints": "outliers",
                    "marker": {
                        "size": 3,
                        "opacity": 0.6
                    },
                    "line": {
                        "width": 1
                    }
                },
                "violin": {
                    "box": {
                        "visible": true
                    },
                    "meanline": {
                        "visible": true
                    },
                    "points": "outliers",
                    "jitter": 0.3,
                    "pointpos": -1.8,
                    "marker": {
                        "size": 3,
                        "opacity": 0.6
                    },
                    "line": {
                        "width": 1
                    }
                },
                "histogram": {
                    "marker": {
                        "line": {
                            "width": 0.5,
                            "color": "#FFFFFF"
                        },
                        "opacity": 0.75
                    },
                    "histnorm": "probability density",
                    "autobinx": true,
                    "nbinsx": 20
                }
            }
        }
    }
}